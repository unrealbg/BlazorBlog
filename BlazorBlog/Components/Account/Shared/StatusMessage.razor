@if (!string.IsNullOrWhiteSpace(DisplayMessage))
{
    var toastLevel = GetToastLevel(DisplayMessage);
    var toastHeading = GetToastHeading(toastLevel);

    <div role="alert"
         style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;">
        @DisplayMessage
    </div>

    <div hidden
         data-status-toast
         data-toast-level="@toastLevel"
         data-toast-heading="@toastHeading"
         data-toast-message="@DisplayMessage">
    </div>
}

@code {
    private string? messageFromCookie;

    [Parameter]
    public string? Message { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string? DisplayMessage => Message ?? messageFromCookie;

    protected override void OnInitialized()
    {
        messageFromCookie = HttpContext.Request.Cookies[IdentityRedirectManager.StatusCookieName];

        if (messageFromCookie is not null)
        {
            HttpContext.Response.Cookies.Delete(IdentityRedirectManager.StatusCookieName);
        }
    }

    private static string GetToastLevel(string message)
    {
        if (message.StartsWith("Error", StringComparison.OrdinalIgnoreCase) ||
            message.Contains("invalid", StringComparison.OrdinalIgnoreCase) ||
            message.Contains("expired", StringComparison.OrdinalIgnoreCase) ||
            message.Contains("failed", StringComparison.OrdinalIgnoreCase))
        {
            return "Error";
        }

        return "Success";
    }

    private static string GetToastHeading(string level) => level == "Error" ? "Error" : "Success";
}
